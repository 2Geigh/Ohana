ARG DOTNET_SDK_VERSION=10.0

FROM mcr.microsoft.com/dotnet/sdk:${DOTNET_SDK_VERSION}-alpine AS build

WORKDIR /app

COPY . .

ARG DOTNET_SDK_VERSION=10.0

RUN dotnet publish -c Release -f net${DOTNET_SDK_VERSION}


FROM mcr.microsoft.com/dotnet/runtime:${DOTNET_SDK_VERSION}-alpine AS dist

ARG DOTNET_SDK_VERSION=10.0

WORKDIR /app

COPY --from=build /app/bin/Release/net${DOTNET_SDK_VERSION} ./bin

CMD ["dotnet", "/app/bin/query_engine.dll"]