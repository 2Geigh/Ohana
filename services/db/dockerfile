FROM postgres:18-alpine

ARG PGVECTOR_VERSION=0.8.6
ARG PG_TEXTSEARCH_VERSION=1.5.1

RUN apk add --no-cache --virtual .build-deps \
        alpine-sdk \
        git \
        clang21 \
        llvm21 \
        && git clone --branch "v${PGVECTOR_VERSION}" --depth 1 \
                https://github.com/pgvector/pgvector.git /tmp/pgvector \
        && make -C /tmp/pgvector PG_CONFIG=/usr/local/bin/pg_config \
        && make -C /tmp/pgvector PG_CONFIG=/usr/local/bin/pg_config install \
        && git clone --branch "v${PG_TEXTSEARCH_VERSION}" --depth 1 \
                https://github.com/timescale/pg_textsearch.git /tmp/pg_textsearch \
        && make -C /tmp/pg_textsearch PG_CONFIG=/usr/local/bin/pg_config \
        && make -C /tmp/pg_textsearch PG_CONFIG=/usr/local/bin/pg_config install \
        && rm -rf /tmp/pgvector /tmp/pg_textsearch \
        && apk del .build-deps

EXPOSE 5432

COPY ./scripts/* /usr/local/bin/monitor
RUN chmod +x /usr/local/bin/monitor

CMD ["postgres", "-c", "shared_preload_libraries=pg_textsearch"]
